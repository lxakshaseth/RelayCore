# ==============================================================================
# RelayCore Environment Configuration
# ==============================================================================

# Application Core
APP_NAME=RelayCore
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Groq API Configuration (Real Hosted Provider)
# Set your free tier key here. Never commit your real key to git!
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com

# Real Provider Quotas & Local Rate Limiter Guardrails (Groq Free Tier)
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=6000
GROQ_RPD_LIMIT=14400

# Stand-in Simulator Settings
SIMULATOR_ENABLED=false
SIMULATOR_PORT=8001
SIMULATOR_DEFAULT_TTFT_MS=320
SIMULATOR_FAILURE_RATE_500=0.02
SIMULATOR_FAILURE_RATE_503=0.01

# Queue & Concurrency Management
MAX_QUEUE_DEPTH=100
WORKER_CONCURRENCY=5
DEFAULT_CLIENT_TIMEOUT_MS=15000
MAX_RETRIES=2

# Document Retrieval & Chunking Defaults
DATA_DIR=data
RESULTS_DIR=results
DEFAULT_CHUNK_SIZE_WORDS=350
DEFAULT_CHUNK_OVERLAP_WORDS=50
DEFAULT_TOP_K=3
